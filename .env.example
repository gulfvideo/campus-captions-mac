# Copy this file to .env and put the real key in it. .env is gitignored.
# The relay never sees this key; only the capture client reads it.
DEEPGRAM_API_KEY=

# Translation, when [translate] provider = "azure".
AZURE_TRANSLATOR_KEY=
# Required for a regional Translator resource, e.g. eastus. Leave empty for a
# global resource.
AZURE_TRANSLATOR_REGION=

# Optional: only if config/event.toml sets a source_token.
# CAPTIONS_SOURCE_TOKEN=

# Optional: only if config/event.toml sets [site] mode = "public".
# CAPTIONS_ADMIN_TOKEN=
