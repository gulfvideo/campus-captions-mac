# Copy this file to .env and put real values in it. .env is gitignored, and
# every value here only ever comes from here or the environment - never from
# a config file.

# Only needed if [capture] backend = "deepgram" in config/event.toml. Can also
# be pasted in from the status page's "Deepgram API key" panel, which writes
# it here for you - no editing required either way.
DEEPGRAM_API_KEY=

# Translation, when [translate] provider = "azure" in config/event.toml.
AZURE_TRANSLATOR_KEY=
# Required for a regional Translator resource, e.g. eastus. Leave empty for a
# global resource.
AZURE_TRANSLATOR_REGION=

# YouTube live captions, source language. From YouTube Studio: set the
# broadcast's caption source to "POST captions to URL" and paste the
# ingestion URL into the status page's "YouTube Live captions" panel (it gets
# saved into config/event.toml, not here) - or put it here directly. This URL
# is a credential: whoever has it can write captions onto the broadcast.
# YOUTUBE_CAPTION_URL=

# One per additional (translated) language, if those go to their own
# broadcasts. No status-page field for these - env only.
# YOUTUBE_CAPTION_URL_ES=
# YOUTUBE_CAPTION_URL_ZH_HANS=

# Optional: only if config/event.toml sets a source_token.
# CAPTIONS_SOURCE_TOKEN=
