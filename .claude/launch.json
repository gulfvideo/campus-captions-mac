{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "relay-source",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "relay",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--directory",
        "site/public"
      ],
      "port": 8790
    }
  ]
}
