# ---- secrets & per-machine config -------------------------------------
# Deepgram key lives here, never in the repo
.env
.env.*
!.env.example

# Real event config (device indices, bind address, source token) is
# machine-specific. config/event.example.toml IS tracked; the live one is not.
config/event.toml
config/*.local.*
*.secret
*.key
*.pem

# Google OAuth for the YouTube caption upload: the client secret and the
# cached token both grant access to the channel.
config/google_client_secret.json
config/google_token.json
captions-*.srt
# the welcome screen's background photo and the header logo, uploaded from
# the status page
config/welcome.*
config/logo.*

# ---- python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- test / tooling ----------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- runtime droppings -------------------------------------------------
logs/
*.log
# captured audio from device debugging - can be large, can contain a live event
*.wav
*.flac
*.raw
recordings/

# ---- editors / OS ------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- claude code -------------------------------------------------------
.claude/settings.local.json
