# ---- secrets & per-machine config -------------------------------------
# Deepgram key lives here, never in the repo
.env
.env.*
!.env.example

# Real event config (device indices, bind address, source token) is
# machine-specific. config/event.example.toml IS tracked; the live one is not.
config/event.toml
config/*.local.*
*.secret
*.key
*.pem

# Google OAuth for the YouTube caption upload: the client secret and the
# cached token both grant access to the channel.
config/google_client_secret.json
config/google_token.json
captions-*.srt
# the welcome screen's background photo and the header logo, uploaded from
# the status page
config/welcome.*
config/logo.*
# pre-downloaded Whisper models (whisper_model_dir in event.toml)
models/

# ---- python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
build/
dist/
# A built or unzipped bundle landing in the repo root - 70MB+ of binary that
# must never reach a commit. `build/` and `dist/` above already cover
# macapp/ and winapp/ output, including the generated Windows VERSIONINFO
# resource (winapp/build/version_info.txt) and the installer .exe.
*.app/
__MACOSX/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- test / tooling ----------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- runtime droppings -------------------------------------------------
logs/
*.log
# captured audio from device debugging - can be large, can contain a live event
*.wav
*.flac
*.raw
recordings/

# ---- editors / OS ------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- claude code -------------------------------------------------------
.claude/settings.local.json

# Node dependencies for the Companion module. package-lock.json IS committed,
# so an install is reproducible; the installed tree is not.
node_modules/

# Companion module build output (companion-module-build)
integrations/companion-module-campus-captions/pkg/
integrations/companion-module-campus-captions/*.tgz

# Locally installed agent skills (npx skills add) and scratch output from
# local tooling. Belongs to whoever is working here, not to what Campus
# Captions ships. Restored after the #32 revert removed it.
.agents/
skills-lock.json
brag-output/
