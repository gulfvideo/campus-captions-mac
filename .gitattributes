# Line endings are load-bearing for the launchers.
#
# A .command with CRLF fails on macOS with "bad interpreter: /bin/bash^M",
# which is a confusing way to learn about line endings in an AV booth.
# A .bat with LF misbehaves in cmd.exe. Pin both regardless of who commits.

*.command  text eol=lf
*.sh       text eol=lf
*.bat      text eol=crlf
