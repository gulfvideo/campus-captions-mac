<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Campus Captions</string>
  <key>CFBundleDisplayName</key><string>Campus Captions</string>
  <key>CFBundleIdentifier</key><string>edu.faulkner.campus-captions</string>
  <key>CFBundleExecutable</key><string>Campus Captions</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.3.0-beta</string>
  <key>CFBundleVersion</key><string>0.3.0-beta</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSHumanReadableCopyright</key><string>Live captioning for campus events.</string>
  <!-- The app sets .accessory at launch and switches to .regular while the
       activation window is up; LSUIElement here would pin it and stop that. -->
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Campus Captions needs the microphone to generate live captions.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Campus Captions uses on-device speech recognition to generate live captions. Audio never leaves this Mac.</string>
  <!-- The operator pages are served from 127.0.0.1 over plain HTTP. -->
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
